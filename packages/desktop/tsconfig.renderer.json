{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/renderer",
    // 修复：renderer 经 armsBrowserBootstrap.ts 引用 src/shared/armsRumBridgeForward 一族，
    // rootDir/include 收窄在 src/renderer 会触发 TS6059/TS6307（rootDir 覆盖不全），放宽到 src。
    "rootDir": "src",
    "lib": ["es2025", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["src/renderer", "src/shared", "../client/src/globals.d.ts"],
  // renderer 直接 import 了 shared；把它补进 references，避免 renderer 单独检查时再走源码回退路径。
  "references": [{ "path": "../shared" }, { "path": "../ui" }, { "path": "../client" }]
}
