{
  "name": "@raspberrycode/provider-regression",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#regression/*": "./src/*.ts",
    "#contract": "./contract.ts",
    "#module": "./module.ts",
    "#public": "./index.ts",
    "#test/*": "./tests/*.ts"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
