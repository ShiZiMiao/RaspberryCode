  },
  "dependencies": {
    "@raspberrycode/adapters": "workspace:*",
    "@raspberrycode/bootstrap": "workspace:*",
    "@raspberrycode/contracts": "workspace:*",
    "@raspberrycode/core": "workspace:*",
    "@raspberrycode/model-option-map": "workspace:*",
    "@raspberrycode/provider": "workspace:*",
    "@raspberrycode/provider-node": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.5"
  }
}
