# 线上地址参考。按需复制到 .env；部署覆盖也可放在未跟踪的 .env.local 中。
# 所有服务端点均为自托管部署地址，无内置厂商默认值。
RASPBERRYCODE_BASE_URL=https://your-server.example
RASPBERRYCODE_CDN_BASE_URL=https://your-server.example

# 远程资源完整覆盖地址，必须包含与运行版本匹配的版本号；删除此项可自动按版本推导。
RASPBERRYCODE_REMOTE_ASSET_CDN_BASE_URL=https://your-server.example/raspberrycode/electron/releases/3.14.0

# 可选本地 Provider 配置文件路径；留空使用内置模板配置。
RASPBERRYCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# 按量计费 Key 的厂商 API 端点：按所用厂商的官方文档填写；留空走该 Key 类型的 wire 兼容默认。
BIGMODEL_API_BASE_URL=

# 内网或私有部署地址没有线上默认值，按需显式填写。
RASPBERRYCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
RASPBERRYCODE_DIST_BASE_URL=
